  "required_test_domains": [
    "language_registry",
    "config_round_trip_and_unknown_language",
    "git_aware_cargo_source_scope",
    "non_compilable_rs_exclusion",
    "t1_truth_and_identity_isolation",
    "t1_determinism_and_resource_limit",
    "t2_definition_position_contract",
    "t2_reference_identity_contract",
    "t2_readiness_retry_and_timeout_cleanup",
    "build_script_and_proc_macro_non_execution",
    "response_provenance_and_completeness",
    "unsupported_t3_t4_fail_closed",
