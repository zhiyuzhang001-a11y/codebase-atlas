      "files": [
        "src/codebase_atlas/refresh_planner.py",
        "src/codebase_atlas/simple_cli.py",
        "src/codebase_atlas/refresh_coordinator.py",
        "src/codebase_atlas/index_state.py"
      ]
    },
    {
